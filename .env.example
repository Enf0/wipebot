# Copy to .env and fill in what you run. Every setting: docs/setup.md.

# Both apps: a Warcraft Logs client (https://www.warcraftlogs.com/api/clients). For the connector, give it the
# redirect URL https://<your host>/wcl/callback.
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
# Optional, if you changed the code: where users get your copy's source (the AGPL asks it; default this repository)
WIPEBOT_SOURCE_URL=
# Optional, sharing the Warcraft Logs account with another copy: this one's share of the hour's points (e.g. 0.1),
# the share of the account's hour it leaves to others (e.g. 0.3); 1 or 0 to say the account is on the new point
# system or not (unset: told from the account's hourly limit)
WIPEBOT_WCL_SHARE=
WIPEBOT_WCL_LEAVE=
WIPEBOT_WCL_USER_POINTS=
# Optional, a connector many guilds share: what one user may spend in an hour, in Warcraft Logs points and tool calls
WIPEBOT_POINTS_PER_USER=
WIPEBOT_CALLS_PER_USER=

# --- The connector ---
# Where members reach it, e.g. https://wipebot.example.com
WIPEBOT_PUBLIC_URL=
# The guild's warcraftlogs.com address, as copied from the browser; comma-separated for several; * for anyone
WIPEBOT_ALLOWED_GUILDS=
# Optional: the highest guild rank that saves raid notes and plans (default 1, Guild Master and Officer)
WIPEBOT_OFFICER_RANK=
# Optional: the reverse proxy's address, for real client IPs in the log
WIPEBOT_TRUSTED_PROXIES=

# --- The Discord bot ---
DISCORD_TOKEN=
# Pays for its answers (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional, in place of ANTHROPIC_API_KEY: answer through OpenRouter, whose key limit /budget shows (docs/setup.md)
OPENROUTER_API_KEY=
# Optional: how raiders chip in to the budget, shown by /budget
WIPEBOT_BUDGET_NOTE=
# Optional: opus (default), sonnet or haiku
WIPEBOT_MODEL=
# Optional, 1: answers also read the channel's last messages and linked ones (needs the Message Content intent)
WIPEBOT_CHANNEL_CONTEXT=
# Optional, 1: keep questions and answers for 90 days, for reviewing them
WIPEBOT_RECORD_ANSWERS=

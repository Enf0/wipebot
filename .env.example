# Copy to .env and fill in what you run. Every setting: docs/setup.md.

# Both apps: a Warcraft Logs client (https://www.warcraftlogs.com/api/clients). For the connector, give it the
# redirect URL https://<your host>/wcl/callback.
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
# Optional, if you changed the code: where users get your copy's source (the AGPL asks it; default this repository)
WIPEBOT_SOURCE_URL=

# --- The connector ---
# Where members reach it, e.g. https://wipebot.example.com
WIPEBOT_PUBLIC_URL=
# The guild's warcraftlogs.com address, as copied from the browser; comma-separated for several
WIPEBOT_ALLOWED_GUILDS=
# Optional: the highest guild rank that saves raid notes and plans (default 1, Guild Master and Officer)
WIPEBOT_OFFICER_RANK=
# Optional: the reverse proxy's address, for real client IPs in the log
WIPEBOT_TRUSTED_PROXIES=

# --- The Discord bot ---
DISCORD_TOKEN=
# Pays for its answers (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional: opus (default), sonnet or haiku
WIPEBOT_MODEL=
# Optional, 1: answers also read the channel's last messages (needs the Message Content intent)
WIPEBOT_CHANNEL_CONTEXT=
# Optional, 1: keep questions and answers for 90 days, for reviewing them
WIPEBOT_RECORD_ANSWERS=
